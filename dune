;; we start by ignoring node_modules. if you need to consume an OCaml 
;; project from `node_modules`, this should work:
;; - remove the `dirs` stanza below
;; - add a `(subdir node_modules (dirs only_your_package))`

(dirs :standard \ node_modules)

(rule
 (alias runtest)
 (enabled_if
  (= %{profile} dev))
 (deps
  (alias_rec test))
 (action
  (run npx jest)))

(rule
 (alias run-examples)
 (deps
  run_examples.sh
  (alias_rec examples)
  (:js
   examples/examples/examples/complex.js
   examples/examples/examples/decode.js
   examples/examples/examples/dynamicDict_Ocaml.js
   examples/examples/examples/dynamicDict_Reason.js
   examples/examples/examples/encode.js
   examples/examples/examples/parse.js
   examples/examples/examples/tree.js))
 (action
  (run ./run_examples.sh %{js})))
