(cram
 (enabled_if
  (= %{profile} dev))
 (deps
  (package jsonkit-melange)
  (package jsonkit)
  ./run.sh
  ../../.ocamlformat
  ../native/ppx_deriving_json_native_test.exe
  ../browser/ppx_deriving_json_js_test.exe))

(cram
 (applies_to ptype_open)
 (enabled_if
  (>= %{ocaml_version} 5.2.0)))

; Labeled-tuple surface syntax (e.g. [x:int * string]) is only parseable by
; the OCaml 5.4+ frontend, so this test can only run there.

(cram
 (applies_to labeled_tuples)
 (enabled_if
  (>= %{ocaml_version} 5.4.0)))

(executable
 (name main)
 (modules example example_json_string main)
 (flags :standard -w -37-69 -open Jsonkit.Primitives)
 (preprocess
  (pps jsonkit.ppx)))

(rule
 (targets e2e.actual.txt)
 (action
  (with-stdout-to
   %{targets}
   (run ./main.exe))))

(rule
 (alias runtest)
 (enabled_if
  (= %{profile} dev))
 (action
  (diff e2e.expected.txt e2e.actual.txt)))
